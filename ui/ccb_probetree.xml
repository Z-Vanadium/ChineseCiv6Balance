			       ColorSet="White_Black" SmallCaps="24" SmallCapsLeading="0" SmallCapsType="EveryWord"
			       String="LOC_CCB_PROBE_TREE_TITLE"/>

			<Label ID="CCBProbeTreeHint" Anchor="C,T" Offset="0,58" Style="FontNormal14" ColorSet="White_Black"
			       WrapWidth="1120" Align="Center" String="LOC_CCB_PROBE_TREE_HINT"/>

			<!-- ===== 可研究对象卡片 ===== -->
			<Grid ID="CCBProbeNodeCard" Anchor="C,T" Offset="0,116" Size="1100,206"
			      Texture="Controls_SubContainer2" SliceCorner="18,18" SliceSize="1,1" Color="79,62,42,255">
