<?xml version="1.0" encoding="utf-8"?>
<!-- [探针·临时] 新科技树面板 · UI（验证完必须整段删除）
     ① 左上 LaunchBar 按钮：本文件只提供实例模板，由 ccb_probetree.lua 注入到
        /InGame/LaunchBar/ButtonStack（与科技/市政/政体按钮同排）；纹理用原版素材。
     ② 主窗口：节点卡片（前置=灌溉 + 150 金币解锁，无科技旗标）
        + 效果矩阵（13 个候选 modifier，逐一点击验证运行时挂载是否生效）。
     文本一律走 LOC 键。
-->
<Context Style="FontNormal14">
	<!-- ===== 左上 LaunchBar 按钮实例模板（49×49，与原版按钮同规格） ===== -->
	<Instance Name="CCBProbeTreeLaunchButton">
		<Button ID="CCBProbeTreeBtn" Anchor="L,C" Size="49,49" Texture="LaunchBar_Hook_GovernmentButton"
		        Style="ButtonNormalText" TextureOffset="0,2" StateOffsetIncrement="0,49"
		        ToolTip="LOC_CCB_PROBE_TREE_LAUNCH_TIP">
			<Image ID="CCBProbeTreeIcon" Size="35,35" Anchor="C,T" Offset="0,3" Texture="LaunchBar_Hook_TechTree"/>
			<Label ID="CCBProbeTreeAlert" String="[ICON_New]" Anchor="R,T" AnchorSide="O,O" Offset="-18,-18" Hidden="1"/>
		</Button>
	</Instance>

	<!-- ===== 主窗口 ===== -->
	<Container Style="FullScreenVignetteConsumer" />

	<Container ID="CCBProbeTreeRoot" Anchor="C,C" Size="1180,800" ConsumeAllMouse="1">
		<Image ID="CCBProbeTreeParchment" Anchor="C,C" Size="parent-24,parent-24"
		       Texture="Ages_ParchmentNormal" StretchMode="Tile"/>

		<Grid ID="CCBProbeTreeFrame" Anchor="C,C" Size="parent-10,parent-10"
		      Texture="Ages_FrameNormal" SliceTextureSize="134,134" SliceCorner="60,74" SliceSize="14,2">

			<Label ID="CCBProbeTreeTitle" Anchor="C,T" Offset="0,20" Style="FontFlair18" FontStyle="glow"
			       ColorSet="White_Black" SmallCaps="24" SmallCapsLeading="0" SmallCapsType="EveryWord"
			       String="LOC_CCB_PROBE_TREE_TITLE"/>

			<Label ID="CCBProbeTreeHint" Anchor="C,T" Offset="0,62" Style="FontNormal14" ColorSet="White_Black"
			       WrapWidth="1100" Align="Center" String="LOC_CCB_PROBE_TREE_HINT"/>

			<!-- ===== 可研究对象卡片 ===== -->
			<Grid ID="CCBProbeNodeCard" Anchor="C,T" Offset="0,124" Size="1080,214"
			      Texture="Controls_SubContainer2" SliceCorner="18,18" SliceSize="1,1" Color="79,62,42,255">
				<Label ID="CCBProbeNodeName" Anchor="C,T" Offset="0,14" Style="FontFlair18" ColorSet="White_Black"
				       String="LOC_CCB_PROBE_NODE_NAME"/>
				<Label ID="CCBProbeNodeEffect" Anchor="C,T" Offset="0,48" Style="FontNormal14" ColorSet="White_Black"
				       WrapWidth="1020" Align="Center" String="LOC_CCB_PROBE_NODE_EFFECT"/>
				<Label ID="CCBProbeNodeReq" Anchor="C,T" Offset="0,86" Style="FontNormal14" ColorSet="White_Black"
				       String="LOC_CCB_PROBE_NODE_REQ"/>
				<Label ID="CCBProbeNodeCost" Anchor="C,T" Offset="0,110" Style="FontNormal14" ColorSet="White_Black"
				       String="LOC_CCB_PROBE_NODE_COST"/>
				<Label ID="CCBProbeNodeStatus" Anchor="C,T" Offset="0,136" Style="FontNormal14" ColorSet="White_Black"
				       WrapWidth="1020" Align="Center" String=""/>
				<GridButton ID="CCBProbeNodeUnlock" Anchor="C,B" Offset="0,14" Style="MainButton" Size="420,44"
				            String="LOC_CCB_PROBE_NODE_BUTTON"/>
			</Grid>

			<!-- ===== 效果矩阵 ===== -->
			<Label ID="CCBProbeMatrixTitle" Anchor="C,T" Offset="0,352" Style="FontFlair18" ColorSet="White_Black"
			       String="LOC_CCB_PROBE_MATRIX_TITLE"/>
			<Label ID="CCBProbeMatrixHint" Anchor="C,T" Offset="0,384" Style="FontNormal14" ColorSet="White_Black"
			       WrapWidth="1100" Align="Center" String="LOC_CCB_PROBE_MATRIX_HINT"/>

			<Stack ID="CCBProbeMatrixLeft" Anchor="C,T" Offset="-280,416" StackGrowth="Down" StackPadding="6">
				<GridButton ID="CCBProbeM1"  Style="MainButton" Size="530,34" String="LOC_CCB_PROBE_M1"/>
				<GridButton ID="CCBProbeM2"  Style="MainButton" Size="530,34" String="LOC_CCB_PROBE_M2"/>
				<GridButton ID="CCBProbeM3"  Style="MainButton" Size="530,34" String="LOC_CCB_PROBE_M3"/>
				<GridButton ID="CCBProbeM4"  Style="MainButton" Size="530,34" String="LOC_CCB_PROBE_M4"/>
				<GridButton ID="CCBProbeM5"  Style="MainButton" Size="530,34" String="LOC_CCB_PROBE_M5"/>
				<GridButton ID="CCBProbeM6"  Style="MainButton" Size="530,34" String="LOC_CCB_PROBE_M6"/>
				<GridButton ID="CCBProbeM7"  Style="MainButton" Size="530,34" String="LOC_CCB_PROBE_M7"/>
			</Stack>

			<Stack ID="CCBProbeMatrixRight" Anchor="C,T" Offset="280,416" StackGrowth="Down" StackPadding="6">
				<GridButton ID="CCBProbeM8"  Style="MainButton" Size="530,34" String="LOC_CCB_PROBE_M8"/>
				<GridButton ID="CCBProbeM9"  Style="MainButton" Size="530,34" String="LOC_CCB_PROBE_M9"/>
				<GridButton ID="CCBProbeM10" Style="MainButton" Size="530,34" String="LOC_CCB_PROBE_M10"/>
				<GridButton ID="CCBProbeM11" Style="MainButton" Size="530,34" String="LOC_CCB_PROBE_M11"/>
				<GridButton ID="CCBProbeM12" Style="MainButton" Size="530,34" String="LOC_CCB_PROBE_M12"/>
				<GridButton ID="CCBProbeM13" Style="MainButton" Size="530,34" String="LOC_CCB_PROBE_M13"/>
			</Stack>

			<GridButton ID="CCBProbeTreeClose" Anchor="C,B" Offset="0,12" Style="MainButton" Size="220,38"
			            String="LOC_CCB_PROBE_TREE_CLOSE"/>
		</Grid>
	</Container>
</Context>
