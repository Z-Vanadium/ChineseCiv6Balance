			<Stack ID="CCBProbeMatrixRight2" Anchor="C,T" Offset="286,692" StackGrowth="Down" StackPadding="6">
				<GridButton ID="CCBProbeR6" Style="MainButton" Size="540,32" String="LOC_CCB_PROBE_R6"/>
				<GridButton ID="CCBProbeR7" Style="MainButton" Size="540,32" String="LOC_CCB_PROBE_R7"/>
