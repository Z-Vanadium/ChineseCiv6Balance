<?xml version="1.0" encoding="utf-8"?>
<!-- [探针·临时 2026-09-22] 新科技树面板 · UI（验证完必须整段删除）
     ① 左上 LaunchBar 按钮：本文件只提供"实例模板"，由 ccb_probetree.lua 注入到
        /InGame/LaunchBar/ButtonStack（与科技/市政/政体按钮同排）。
        纹理全部用原版 LaunchBar 素材：LaunchBar_Hook_GovernmentButton（按钮底）、
        LaunchBar_Hook_TechTree（图标），与科技树按钮同源。
     ② 主窗口：羊皮纸底 + 描金外框（同泰姬陵弹窗的已验证风格），内含一个"可研究对象"卡片。
     文本一律走 LOC 键（Civ6 的 String 按本地化表查询，直接写中文会空白）。
-->
<Context Style="FontNormal14">
	<!-- ===== 左上 LaunchBar 按钮实例模板（49×49，与原版按钮同规格） ===== -->
	<Instance Name="CCBProbeTreeLaunchButton">
		<Button ID="CCBProbeTreeBtn" Anchor="L,C" Size="49,49" Texture="LaunchBar_Hook_GovernmentButton"
		        Style="ButtonNormalText" TextureOffset="0,2" StateOffsetIncrement="0,49"
		        ToolTip="LOC_CCB_PROBE_TREE_LAUNCH_TIP">
			<Image ID="CCBProbeTreeIcon" Size="35,35" Anchor="C,T" Offset="0,3" Texture="LaunchBar_Hook_TechTree"/>
			<Label ID="CCBProbeTreeAlert" String="[ICON_New]" Anchor="R,T" AnchorSide="O,O" Offset="-18,-18" Hidden="1"/>
		</Button>
	</Instance>

	<!-- ===== 主窗口 ===== -->
	<Container Style="FullScreenVignetteConsumer" />

	<Container ID="CCBProbeTreeRoot" Anchor="C,C" Size="980,600" ConsumeAllMouse="1">
		<Image ID="CCBProbeTreeParchment" Anchor="C,C" Size="parent-24,parent-24"
		       Texture="Ages_ParchmentNormal" StretchMode="Tile"/>

		<Grid ID="CCBProbeTreeFrame" Anchor="C,C" Size="parent-10,parent-10"
		      Texture="Ages_FrameNormal" SliceTextureSize="134,134" SliceCorner="60,74" SliceSize="14,2">

			<Label ID="CCBProbeTreeTitle" Anchor="C,T" Offset="0,24" Style="FontFlair18" FontStyle="glow"
			       ColorSet="White_Black" SmallCaps="24" SmallCapsLeading="0" SmallCapsType="EveryWord"
			       String="LOC_CCB_PROBE_TREE_TITLE"/>

			<Label ID="CCBProbeTreeHint" Anchor="C,T" Offset="0,74" Style="FontNormal14" ColorSet="White_Black"
			       WrapWidth="860" Align="Center" String="LOC_CCB_PROBE_TREE_HINT"/>

			<!-- ===== 可研究对象卡片 ===== -->
			<Grid ID="CCBProbeNodeCard" Anchor="C,T" Offset="0,150" Size="820,320"
			      Texture="Controls_SubContainer2" SliceCorner="18,18" SliceSize="1,1" Color="79,62,42,255">

				<Label ID="CCBProbeNodeName" Anchor="C,T" Offset="0,18" Style="FontFlair18" ColorSet="White_Black"
				       String="LOC_TECH_CCB_PROBE_PLANTATION_NAME"/>

				<Label ID="CCBProbeNodeEffect" Anchor="C,T" Offset="0,56" Style="FontNormal14" ColorSet="White_Black"
				       WrapWidth="760" Align="Center" String="LOC_CCB_PROBE_NODE_EFFECT"/>

				<Label ID="CCBProbeNodeReq" Anchor="C,T" Offset="0,104" Style="FontNormal14" ColorSet="White_Black"
				       String="LOC_CCB_PROBE_NODE_REQ"/>

				<Label ID="CCBProbeNodeCost" Anchor="C,T" Offset="0,132" Style="FontNormal14" ColorSet="White_Black"
				       String="LOC_CCB_PROBE_NODE_COST"/>

				<Label ID="CCBProbeNodeStatus" Anchor="C,T" Offset="0,164" Style="FontNormal14" ColorSet="White_Black"
				       WrapWidth="760" Align="Center" String=""/>

				<GridButton ID="CCBProbeNodeUnlock" Anchor="C,T" Offset="0,206" Style="MainButton" Size="420,48"
				            String="LOC_CCB_PROBE_NODE_BUTTON"/>
			</Grid>

			<GridButton ID="CCBProbeTreeClose" Anchor="C,B" Offset="0,14" Style="MainButton" Size="220,41"
			            String="LOC_CCB_PROBE_TREE_CLOSE"/>
		</Grid>
	</Container>
</Context>
