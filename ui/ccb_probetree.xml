				       String="LOC_CCB_PROBE_NODE_REQ"/>
				<Label ID="CCBProbeNodeCost" Anchor="C,T" Offset="0,104" Style="FontNormal14" ColorSet="White_Black"
				       String="LOC_CCB_PROBE_NODE_COST"/>
				<Label ID="CCBProbeNodeStatus" Anchor="C,T" Offset="0,128" Style="FontNormal14" ColorSet="White_Black"
				       WrapWidth="1040" Align="Center" String=""/>
				<GridButton ID="CCBProbeNodeUnlock" Anchor="C,B" Offset="0,12" Style="MainButton" Size="420,42"
				            String="LOC_CCB_PROBE_NODE_BUTTON"/>
			</Grid>

			<!-- ===== 第一轮矩阵（已实测：除 M10/M13 外均生效） ===== -->
